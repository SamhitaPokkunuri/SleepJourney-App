    jdbc_connection_string => "jdbc:mysql://ncgiot.c0zxlcypyfpj.eu-west-2.rds.amazonaws.com:3306/Nexus"
    statement => "SELECT 'Customers' as TableName, CustomerID as ID, CONCAT('Customers_',CustomerID) as DocumentID, Name FROM Customers"
    schedule => "0 0 */6 * * *"
  }

