    jdbc_driver_library => "/etc/logstash/mysql-connector-java-8.0.22/mysql-connector-java-8.0.22.jar"
    jdbc_connection_string => "jdbc:mysql://ncgiot.c0zxlcypyfpj.eu-west-2.rds.amazonaws.com:3306/Nexus"
    statement => "SELECT 'Department' as TableName, CustDeptID as ID, CONCAT('Department_',CustDeptID) as DocumentID, Name, CustomerID FROM Department"
