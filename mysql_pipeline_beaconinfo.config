# Beats -> Logstash -> Elasticsearch pipeline.

# JDBC configuration and view details of a device
input {
  ############################ BeaconInfo View ##################################

  jdbc {
    jdbc_user => "DauntlessDev"
    jdbc_password => "z7BM.WbGo7Dr"
    jdbc_driver_class => "com.mysql.jdbc.Driver"
    jdbc_driver_library => "/etc/logstash/mysql-connector-java-8.0.22/mysql-connector-java-8.0.22.jar"
    jdbc_connection_string => "jdbc:mysql://ncgiot.c0zxlcypyfpj.eu-west-2.rds.amazonaws.com:3306/Nexus"
    statement => "SELECT 'BeaconInfo' as TableName, Devices.DeviceID as ID, CONCAT('BeaconInfo_',Devices.DeviceID) as DocumentID, Department.CustDeptID as 'DepartmentID', Floors.FloorID as 'FloorID', Devices.DeviceID as 'DeviceID', Buildings.BuildingID as 'BuildingID', Customers.CustomerID as 'CustomerID', Customers.Name as 'Customer', Buildings.Name as 'Building',  Floors.Name as 'Floor',Devices.SN as 'Serial',Devices.Name as 'Name',Devices.Lat as 'Lat',Devices.Long as 'Long',Devices.Elv as 'Elevation', Devices.X as 'X',Devices.Y as 'Y',DeviceType.Name as 'Type',Platforms.Name as 'Platform',Department.Name as 'Department',LocationType.Name as 'Location' FROM Devices LEFT JOIN Floors ON Devices.FloorID = Floors.FloorID LEFT JOIN Buildings ON Floors.BuildingID = Buildings.BuildingID LEFT JOIN Customers ON Buildings.CustomerID = Customers.CustomerID LEFT JOIN DeviceType ON Devices.DeviceTypeID = DeviceType.DeviceTypeID LEFT JOIN Platforms ON DeviceType.PlatformID = Platforms.PlatformID LEFT JOIN Department ON Devices.CustDeptID = Department.CustDeptID LEFT JOIN LocationType ON Devices.LocationTypeID = LocationType.LocationTypeID"
    schedule => "0 0 */6 * * *"
  }

  ############################ Buildings ##################################

  jdbc {
    jdbc_user => "DauntlessDev"
    jdbc_password => "z7BM.WbGo7Dr"
    jdbc_driver_class => "com.mysql.jdbc.Driver"
    jdbc_driver_library => "/etc/logstash/mysql-connector-java-8.0.22/mysql-connector-java-8.0.22.jar"
    jdbc_connection_string => "jdbc:mysql://ncgiot.c0zxlcypyfpj.eu-west-2.rds.amazonaws.com:3306/Nexus"
    statement => "SELECT 'Buildings' as TableName, BuildingID as ID, CONCAT('Buildings_',BuildingID) as DocumentID, Name, Lat, `Long`, CustomerID, CountryID FROM Buildings"
    schedule => "0 0 */6 * * *"
  }

  ############################ Countries ##################################

  jdbc {
    jdbc_user => "DauntlessDev"
    jdbc_password => "z7BM.WbGo7Dr"
    jdbc_driver_class => "com.mysql.jdbc.Driver"
    jdbc_driver_library => "/etc/logstash/mysql-connector-java-8.0.22/mysql-connector-java-8.0.22.jar"
    jdbc_connection_string => "jdbc:mysql://ncgiot.c0zxlcypyfpj.eu-west-2.rds.amazonaws.com:3306/Nexus"
    statement => "SELECT 'Countries' as TableName, CountryID as ID, CONCAT('Countries_',CountryID) as DocumentID, Name, `Alpha-2 Code`, `Alpha-3 Code` FROM Countries"
    schedule => "0 0 */6 * * *"
  }

  ############################ Countries ##################################

  jdbc {
