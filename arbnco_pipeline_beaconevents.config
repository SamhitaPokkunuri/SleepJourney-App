# Sample Logstash configuration for creating a simple
# Beats -> Logstash -> Elasticsearch pipeline.

# Input port from filebeat 5027
input {
  beats {
    port => 5027
  }
}

# filter to elasticsearch to get the device serial number and then with the serial number get the beacon details. 
# Both the searches are on elasticsearch - removing dependency on mysql 
filter {
  json {
    source => "message"
    target => "[@metadata][string-indexed]"
  }
  ruby {
    code => "
      # extract the string-indexed object to a local variable
      # iterate over the keys in the order of the string-encoded integer index
      #items_array = string_indexed['data'].keys.sort_by(&:to_i).map do |key|
        # get the item from the indexed map
        #string_indexed[key]
      #end
      # set the items array.
      #event.set('[@metadata][items-array]', items_array)

      beacons_array = []
      string_indexed = event.get('[@metadata][string-indexed]')
      string_indexed['data'].keys.map do |key|
        string_indexed['data'][key].keys.map do |beaconkey|
          beacon_item = {}
          beacon_item['event_at'] = key
          beacon_item['device_id'] = beaconkey

          beacon_item['count'] = string_indexed['data'][key][beaconkey]['count'] == nil ? 'null' : string_indexed['data'][key][beaconkey]['count']
          beacon_item['temperature'] = string_indexed['data'][key][beaconkey]['temperature'] == nil ? 'null' : string_indexed['data'][key][beaconkey]['temperature']
          beacon_item['co2'] = string_indexed['data'][key][beaconkey]['co2'] == nil ? 'null' : string_indexed['data'][key][beaconkey]['co2']
          beacon_item['als'] = string_indexed['data'][key][beaconkey]['als'] == nil ? 'null' : string_indexed['data'][key][beaconkey]['als']
          beacon_item['tvoc'] = string_indexed['data'][key][beaconkey]['tvoc'] == nil ? 'null' : string_indexed['data'][key][beaconkey]['tvoc']
          beacon_item['pm'] = string_indexed['data'][key][beaconkey]['pm'] == nil ? 'null' : string_indexed['data'][key][beaconkey]['pm']
          beacon_item['pm25'] = string_indexed['data'][key][beaconkey]['pm25'] == nil ? 'null' : string_indexed['data'][key][beaconkey]['pm25']
          beacon_item['pm10'] = string_indexed['data'][key][beaconkey]['pm10'] == nil ? 'null' : string_indexed['data'][key][beaconkey]['pm10']
          beacon_item['humidity'] = string_indexed['data'][key][beaconkey]['humidity'] == nil ? 'null' : string_indexed['data'][key][beaconkey]['humidity']
          beacons_array.push(beacon_item)
          #break
        end
        #break
      end
      event.set('[@metadata][items-array]', beacons_array)
    "
  }
  split {
    field => "[@metadata][items-array]"
    target => "[@metadata][single-item]"  
  }
  mutate {
    remove_field => ["message"]
  }
  mutate {
    remove_field => ["message"]
    add_field => { "device_id" => "%{[@metadata][single-item][device_id]}" }
    add_field => { "[json][attributes][event_at]" => "%{[@metadata][single-item][event_at]}" }
    add_field => { "[json][attributes][temperature]" => "%{[@metadata][single-item][temperature]}" }
    add_field => { "[json][attributes][humidity]" => "%{[@metadata][single-item][humidity]}" }
    add_field => { "[json][attributes][co2]" => "%{[@metadata][single-item][co2]}" }
    add_field => { "[json][attributes][count]" => "%{[@metadata][single-item][count]}" }
    add_field => { "[json][attributes][als]" => "%{[@metadata][single-item][als]}" }
    add_field => { "[json][attributes][tvoc]" => "%{[@metadata][single-item][tvoc]}" }
    add_field => { "[json][attributes][pm]" => "%{[@metadata][single-item][pm]}" }
    add_field => { "[json][attributes][pm25]" => "%{[@metadata][single-item][pm25]}" }
    add_field => { "[json][attributes][pm10]" => "%{[@metadata][single-item][pm10]}" }
  }
  elasticsearch {
    hosts => ["https://4e1e3b07c7b943fea7a939970a7f5643.uksouth.azure.elastic-cloud.com:9243"]
    index => "arbnco-nexus-ncg-staging-info"
    user => "sateeshp@wearedauntless.com"
    password => "san7aung.kaic_LUK"
    query => "json.id:%{[@metadata][single-item][device_id]}"
    fields => { "[json][device_mappings][current][external_device_id]" => "device_serial_number" }
    result_size => 1
  }
  elasticsearch {
    hosts => ["https://4e1e3b07c7b943fea7a939970a7f5643.uksouth.azure.elastic-cloud.com:9243"]
    index => "mysql-nexus-ncg-staging-beaconinfo"
    user => "sateeshp@wearedauntless.com"
    password => "san7aung.kaic_LUK"
    query => "serial:%{[device_serial_number]}"
    fields => {
      "departmentid" => "DepartmentID"
      "elevation" => "Elevation"
      "y" => "Y"
      "x" => "X"
      "buildingid" => "BuildingID"
      "customer" => "Customer"
      "lat" => "Lat"
      "long" => "Long"
      "department" => "Department"
      "floor" => "Floor"
      "serial" => "Serial"
      "platform" => "Platform"
      "location" => "LocationName"
      "name" => "Name"
      "floorid" => "FloorID"
      "customerid" => "CustomerID"
      "type" => "Type"
      "deviceid" => "DeviceID"
      "building" => "Building"
    }
    result_size => 1
  }
  
  # add all the device related fields from the elastic search
  mutate {
   add_field => { "[geo][location][lat]" => "%{[Lat]}" }
   add_field => { "[geo][location][lon]" => "%{[Long]}" }
  }
  mutate {
    convert => {
      "[geo][location][lat]" => "float"
      "[geo][location][lon]" => "float"
      "[geo][location][type]" => "geo_point"
      "[json][attributes][temperature]" => "float"
      "[json][attributes][co2]" => "float"
      "[json][attributes][humidity]" => "float"
      "[json][attributes][als]" => "float"
      "[json][attributes][tvoc]" => "float"
      "[json][attributes][pm]" => "float"
      "[json][attributes][pm25]" => "float"
      "[json][attributes][pm10]" => "float"
    }
  }
  date {
    target => "@timestamp"
    match => ["[json][attributes][event_at]", "yyyy-MM-dd HH:mm:ss 'UTC'"]
  }
  fingerprint {
    source => "message"
    target => "[@metadata][single-item]"
    method => "SHA1"
    key => "Duplicate events"
    base64encode => true
  }
}

# elastic search output
output {
  elasticsearch {
    hosts => ["https://4e1e3b07c7b943fea7a939970a7f5643.uksouth.azure.elastic-cloud.com:9243"]
    index => "arbnco-nexus-ncg-dev-events-%{[@metadata][beat]}-%{[@metadata][version]}-%{+YYYY.MM.dd}"
    user => "sateeshp@wearedauntless.com"
    password => "san7aung.kaic_LUK"
    document_id => "%{[@metadata][single-item]}"
  }
}
